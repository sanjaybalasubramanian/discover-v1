# ============================================
# TESTING CONFIGURATION (Quick Test)
# ============================================

# Job Discovery (Phase 1) - Small test
JOBSPY_RESULTS_PER_SITE=3         # Only 3 jobs per site for testing
JOBSPY_HOURS_OLD=168              # 7 days

# Research Agent (Phase 2) - Small test  
RESEARCH_COMPANY_LIMIT=5          # Only 5 companies for testing
RESEARCH_PARALLEL_WORKERS=2       # 2 workers for local testing
RESEARCH_AGENT_TIMEOUT=60         # 60 seconds

# Job Filtering
MIN_FIT_SCORE=50                  # Minimum relevance score

# Expected results:
# - Jobs: ~90 (6 searches × 5 sites × 3 results)
# - Companies: 5 researched
# - Contacts: ~15-25
# - Time: ~5-8 minutes
